# Environment: Production (npm run build)

# Base URL of the Fiadito RESTful API (Spring Boot backend: Fiadito/Backend, port 8080).
VITE_FIADITO_API_URL="http://localhost:8080/api/v1"

# Optional: simulated "today" (YYYY-MM-DD) to rehearse test cases on another date.
# Use the same date in the backend (SYSTEM_DATE in its .env), because the backend computes the late interest.
VITE_SYSTEM_DATE=""

# VITE_PRIME_UI_LICENSE_KEY (PrimeUI license key of PrimeVue 5) goes only in .env.local, which is not committed.
