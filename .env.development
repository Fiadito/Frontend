# Environment: Development (npm run dev)

# Base URL of the Fiadito RESTful API. For now it is the Fake API served by json-server (npm run fake-api).
# When the Spring Boot backend is ready, change it to http://localhost:8080/api/v1
VITE_FIADITO_API_URL="http://localhost:3000/api/v1"

# Endpoint paths (same names as Tabla 7 of the report).
VITE_BUSINESSES_ENDPOINT_PATH="/negocios"
VITE_USERS_ENDPOINT_PATH="/usuarios"
VITE_MEMBERS_ENDPOINT_PATH="/socios"
VITE_PRODUCTS_ENDPOINT_PATH="/productos"
VITE_SALES_ENDPOINT_PATH="/ventas"
VITE_INSTALLMENTS_ENDPOINT_PATH="/cuotas"
VITE_PAYMENTS_ENDPOINT_PATH="/pagos"
VITE_OPERATIONS_ENDPOINT_PATH="/bitacora"

# Optional: simulated "today" (YYYY-MM-DD) to rehearse test cases on another date.
# Leave it empty to use the real date of the computer.
VITE_SYSTEM_DATE=""

# VITE_PRIME_UI_LICENSE_KEY (PrimeUI license key of PrimeVue 5) goes only in .env.local, which is not committed.
